# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD


# ==========================================
# Spring Boot Database
# ==========================================

DB_URL=jdbc:postgresql://postgres:5432/securevault
DB_USERNAME=securevault
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD


# ==========================================
# Gmail SMTP
# ==========================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password


# ==========================================
# JWT
# ==========================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# ==========================================
# Existing AES encryption key
# Must remain 16 characters for current implementation
# ==========================================

ENCRYPTION_KEY=CHANGE_ME_16CHAR


# ==========================================
# CORS
# ==========================================

CORS_ALLOWED_ORIGIN=http://localhost